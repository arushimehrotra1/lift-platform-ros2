<?xml version="1.0"?>
<package format="3">
  <name>lift_platform</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge and keyboard control for the ESP32 powered lifting platform</description>
  <maintainer email="you@example.com">lift</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
